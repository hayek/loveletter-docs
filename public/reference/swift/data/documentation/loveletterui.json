{"abstract":[{"type":"text","text":"A drop-in SwiftUI feedback sheet on top of "},{"code":"LoveLetterCore","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"roleHeading":"Framework","externalID":"LoveLetterUI","symbolKind":"module","modules":[{"name":"LoveLetterUI"}],"role":"collection","title":"LoveLetterUI"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI"},"hierarchy":{"paths":[[]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"LoveLetterUI","type":"codeVoice"},{"type":"text","text":" ships a single, themeable view — "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackSheet"},{"type":"text","text":" — that handles the entire feedback flow: type selection, validated form, async submission, success animation, and dismissal. It runs on iOS, iPadOS, macOS, tvOS, watchOS, and visionOS with platform-appropriate styling."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you don’t want the bundled sheet — for instance, because you have your own form aesthetic — use "},{"code":"LoveLetterCore\/FeedbackClient","type":"codeVoice"},{"type":"text","text":" directly and skip this module entirely."}],"type":"paragraph"},{"text":"Minimal integration","anchor":"Minimal-integration","type":"heading","level":3},{"code":["import LoveLetterCore","import LoveLetterUI","","struct ContentView: View {","    let feedback: FeedbackClient","    @State private var showFeedback = false","","    var body: some View {","        Button(\"Send Feedback\") { showFeedback = true }","            .sheet(isPresented: $showFeedback) {","                FeedbackSheet(client: feedback)","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The default theme uses red for bug reports, blue\/purple for feature requests, and English copy. Both can be overridden per call — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Theming"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Localization"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"What you get out of the box","anchor":"What-you-get-out-of-the-box","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Type selector"}]},{"type":"text","text":" — radio-style cards for bug and feature request."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Validated fields"}]},{"type":"text","text":" — title (required), description (required, character count up to a configurable limit), email (optional, soft-validated)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Privacy notice"}]},{"type":"text","text":" — explicit “device information will be automatically included” line so users aren’t surprised."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Async submission"}]},{"type":"text","text":" — disables the button, shows a spinner, fires "},{"type":"codeVoice","code":"onSubmit"},{"type":"text","text":" or "},{"type":"codeVoice","code":"onError"},{"type":"text","text":" callbacks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Success animation"}]},{"type":"text","text":" — animated checkmark + the GitHub issue number, then dismiss via “Done”."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Keyboard shortcuts"}]},{"type":"text","text":" — ⌘↩ submits on macOS \/ iPadOS, default action key dismisses on success."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"App Store rating prompt"}]},{"type":"text","text":" — praise converts into a rating without leaving the app. See below."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Analytics"}]},{"type":"text","text":" — the whole funnel, from sheet opened to rating prompt, through one optional sink. Configure it on the client via "},{"type":"codeVoice","code":"FeedbackClient(analytics:)"},{"type":"text","text":"; see the Analytics article in "},{"type":"codeVoice","code":"LoveLetterCore"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"text":"App Store rating prompt","anchor":"App-Store-rating-prompt","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"When a submission turns out to be unqualified praise, the sheet follows it with the native App Store rating prompt. This is on by default; pass "},{"code":"requestsAppStoreReview: false","type":"codeVoice"},{"type":"text","text":" to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackSheet\/init(client:theme:descriptionLimit:extraFields:requestsAppStoreReview:onSubmit:onError:onSubmitReport:)"},{"type":"text","text":" to opt out."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The praise check runs entirely on-device through Apple Intelligence (Foundation Models, iOS\/macOS\/visionOS 26+) — the text is never sent anywhere for it, and no app ID or other configuration is required. On a device without Apple Intelligence — an older OS, ineligible hardware, the feature switched off, or the model still downloading — the check is skipped and the flow behaves exactly as it did before the option existed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Three properties are worth relying on:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The report always goes out first."}]},{"type":"text","text":" The check runs after the transport has returned, so a slow, erroring, or absent model cannot affect or delay a submission."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"The bar is pure praise."}]},{"type":"text","text":" Text mixing appreciation with a bug, complaint, criticism, question, or request does not qualify, and an uncertain verdict counts as not praise."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Silence is the failure mode."}]},{"type":"text","text":" A guardrail trip, a refusal, an unsupported language, or a timeout all mean “no prompt”, never a broken submission."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The alert’s copy and how often it appears belong to the system, so it is deliberately not part of "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct"},{"type":"text","text":"; the App Store shows it at most a few times per user per year. The option is inert on watchOS and tvOS, which have no rating prompt."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loveletterui"]}],"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackSheet"]},{"anchor":"Customization","title":"Customization","identifiers":["doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Theming","doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Localization","doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme"]}],"references":{"doc://LoveLetterUI/documentation/LoveLetterUI/FeedbackTheme/Copy-swift.struct":{"url":"\/documentation\/loveletterui\/feedbacktheme\/copy-swift.struct","abstract":[{"type":"text","text":"Every visible string on the sheet."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Copy"}],"title":"FeedbackTheme.Copy","role":"symbol","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Copy"}]},"doc://LoveLetterUI/documentation/LoveLetterUI/FeedbackSheet":{"title":"FeedbackSheet","navigatorTitle":[{"text":"FeedbackSheet","kind":"identifier"}],"role":"symbol","url":"\/documentation\/loveletterui\/feedbacksheet","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackSheet","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"FeedbackSheet","kind":"identifier"}],"abstract":[{"type":"text","text":"A drop-in feedback form, presentable from any SwiftUI view via "},{"type":"codeVoice","code":".sheet(...)"},{"type":"text","text":"."}],"kind":"symbol","type":"topic"},"doc://LoveLetterUI/documentation/LoveLetterUI/FeedbackSheet/init(client:theme:descriptionLimit:extraFields:requestsAppStoreReview:onSubmit:onError:onSubmitReport:)":{"title":"init(client:theme:descriptionLimit:extraFields:requestsAppStoreReview:onSubmit:onError:onSubmitReport:)","role":"symbol","url":"\/documentation\/loveletterui\/feedbacksheet\/init(client:theme:descriptionlimit:extrafields:requestsappstorereview:onsubmit:onerror:onsubmitreport:)","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackSheet\/init(client:theme:descriptionLimit:extraFields:requestsAppStoreReview:onSubmit:onError:onSubmitReport:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"client"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:14LoveLetterCore14FeedbackClientV","text":"FeedbackClient"},{"kind":"text","text":", "},{"kind":"externalParam","text":"theme"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12LoveLetterUI13FeedbackThemeV","text":"FeedbackTheme"},{"kind":"text","text":", "},{"kind":"externalParam","text":"descriptionLimit"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extraFields"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"], "},{"kind":"externalParam","text":"requestsAppStoreReview"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onSubmit"},{"kind":"text","text":": @"},{"kind":"typeIdentifier","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onError"},{"kind":"text","text":": @"},{"kind":"typeIdentifier","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" ("},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5ErrorP","text":"Error"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":", "},{"kind":"externalParam","text":"onSubmitReport"},{"kind":"text","text":": (@"},{"kind":"typeIdentifier","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" ("},{"kind":"typeIdentifier","preciseIdentifier":"s:14LoveLetterCore14FeedbackReportV","text":"FeedbackReport"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":")?)"}],"abstract":[{"type":"text","text":"Builds a feedback sheet."}],"kind":"symbol","type":"topic"},"doc://LoveLetterUI/documentation/LoveLetterUI":{"role":"collection","url":"\/documentation\/loveletterui","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI","kind":"symbol","type":"topic","title":"LoveLetterUI","abstract":[{"type":"text","text":"A drop-in SwiftUI feedback sheet on top of "},{"type":"codeVoice","code":"LoveLetterCore"},{"type":"text","text":"."}]},"doc://LoveLetterUI/documentation/LoveLetterUI/Theming":{"kind":"article","abstract":[{"type":"text","text":"Customize the accent colors and all visible copy via "},{"isActive":true,"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme","type":"reference"},{"type":"text","text":"."}],"title":"Theming","role":"collectionGroup","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Theming","type":"topic","url":"\/documentation\/loveletterui\/theming"},"doc://LoveLetterUI/documentation/LoveLetterUI/FeedbackTheme":{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme","url":"\/documentation\/loveletterui\/feedbacktheme","navigatorTitle":[{"kind":"identifier","text":"FeedbackTheme"}],"kind":"symbol","abstract":[{"type":"text","text":"Visual + copy customization for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackSheet"},{"type":"text","text":"."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeedbackTheme"}],"type":"topic","title":"FeedbackTheme"},"doc://LoveLetterUI/documentation/LoveLetterUI/Localization":{"url":"\/documentation\/loveletterui\/localization","type":"topic","kind":"article","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Localization","abstract":[{"type":"text","text":"Pass pre-localized strings into "},{"type":"reference","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","isActive":true},{"type":"text","text":" so the SDK doesn’t have to ship a strings table."}],"title":"Localization","role":"collectionGroup"}}}