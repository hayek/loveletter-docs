{"abstract":[{"text":"Pass pre-localized strings into ","type":"text"},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","type":"reference","isActive":true},{"text":" so the SDK doesn’t have to ship a strings table.","type":"text"}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Localization","modules":[{"name":"LoveLetterUI"}]},"seeAlsoSections":[{"anchor":"Customization","identifiers":["doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Theming","doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme"],"title":"Customization","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Localization"},"hierarchy":{"paths":[["doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI"],["doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI","doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Theming"]]},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","type":"reference","isActive":true},{"type":"text","text":" uses plain "},{"type":"codeVoice","code":"String"},{"type":"text","text":" fields rather than "},{"type":"codeVoice","code":"LocalizedStringKey"},{"type":"text","text":". This is deliberate: integrators ship their own strings catalogs and pass already-localized text into the theme. The SDK doesn’t bundle a strings file, doesn’t pick a locale, and doesn’t override your app’s localization workflow."}],"type":"paragraph"},{"text":"Using `String(localized:)`","anchor":"Using-Stringlocalized","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"In a localized app ("},{"type":"codeVoice","code":".xcstrings"},{"type":"text","text":" catalog or "},{"type":"codeVoice","code":"Localizable.strings"},{"type":"text","text":"):"}],"type":"paragraph"},{"code":["let copy = FeedbackTheme.Copy(","    headerTitle:             String(localized: \"feedback_header\"),","    bugSubtitle:             String(localized: \"feedback_bug_subtitle\"),","    featureSubtitle:         String(localized: \"feedback_feature_subtitle\"),","    bugLabel:                String(localized: \"feedback_type_bug\"),","    bugTagline:              String(localized: \"feedback_type_bug_tagline\"),","    featureLabel:            String(localized: \"feedback_type_feature\"),","    featureTagline:          String(localized: \"feedback_type_feature_tagline\"),","    titleLabel:              String(localized: \"feedback_title_label\"),","    titleFieldName:          String(localized: \"feedback_title_label\"),","    titlePlaceholder:        String(localized: \"feedback_title_placeholder\"),","    descriptionLabel:        String(localized: \"feedback_description_label\"),","    descriptionFieldName:    String(localized: \"feedback_description_label\"),","    descriptionPlaceholder:  String(localized: \"feedback_description_placeholder\"),","    emailLabel:              String(localized: \"feedback_email_label\"),","    emailOptionalBadge:      String(localized: \"feedback_optional\"),","    emailPlaceholder:        String(localized: \"feedback_email_placeholder\"),","    emailHint:               String(localized: \"feedback_email_hint\"),","    privacyNotice:           String(localized: \"feedback_privacy_notice\"),","    submitButton:            String(localized: \"feedback_submit_button\"),","    doneButton:              String(localized: \"feedback_done_button\"),","    successTitle:            String(localized: \"feedback_success_title\"),","    successMessage:          String(localized: \"feedback_success_message\"),","    errorAlertTitle:         String(localized: \"feedback_error_title\"),","    validationPromptTemplate: String(localized: \"feedback_validation_template\")",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"String(localized:)"},{"type":"text","text":" resolves at runtime against "},{"type":"codeVoice","code":"Bundle.main"},{"type":"text","text":", so each call picks up the user’s current locale and any in-flight language change."}],"type":"paragraph"},{"text":"The validation prompt template","anchor":"The-validation-prompt-template","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"validationPromptTemplate"},{"type":"text","text":" is interpolated when the user submits with required fields blank. The literal token "},{"type":"codeVoice","code":"{fields}"},{"type":"text","text":" is replaced with a comma-separated list of missing field names:"}],"type":"paragraph"},{"code":["\"Please fill in: {fields}\"   →   \"Please fill in: Title, Description\""],"type":"codeListing","syntax":"text"},{"inlineContent":[{"type":"text","text":"For locales that need different word order, encode it in the template:"}],"type":"paragraph"},{"code":["\"Bitte ausfüllen: {fields}\"   →   \"Bitte ausfüllen: Titel, Beschreibung\""],"type":"codeListing","syntax":"text"},{"inlineContent":[{"type":"text","text":"The names that fill "},{"type":"codeVoice","code":"{fields}"},{"type":"text","text":" come from "},{"type":"codeVoice","code":"titleFieldName"},{"type":"text","text":" and "},{"type":"codeVoice","code":"descriptionFieldName"},{"type":"text","text":". Keep those short and in the same locale."}],"type":"paragraph"},{"text":"Right-to-left layout","anchor":"Right-to-left-layout","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"SwiftUI handles RTL automatically — the entire sheet flips when the system layout direction is right-to-left. No extra theme work needed; just provide RTL-correct copy strings."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loveletterui\/localization"]}],"top