nce","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","isActive":true},{"type":"text","text":" so the SDK doesn’t have to ship a strings table."}],"title":"Localization","role":"collectionGroup"},"doc://LoveLetterUI/documentation/LoveLetterUI/FeedbackTheme/bugAccent":{"url":"\/documentation\/loveletterui\/feedbacktheme\/bugaccent","type":"topic","kind":"symbol","identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/bugAccent","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"bugAccent","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Color","preciseIdentifier":"s:7SwiftUI5ColorV","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Accent color used when the user selects “Bug” — drives the hero"},{"type":"text","text":" "},{"type":"text","text":"gradient, type-card highlight, and success ring."}],"title":"bugAccent","role":"symbol"}}}