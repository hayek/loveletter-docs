{"hierarchy":{"paths":[["doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI"]]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Theming","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"LoveLetterUI"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Theming"},"abstract":[{"type":"text","text":"Customize the accent colors and all visible copy via "},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme","type":"reference","isActive":true},{"type":"text","text":"."}],"sections":[],"seeAlsoSections":[{"title":"Customization","anchor":"Customization","identifiers":["doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Localization","doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme"],"generated":true}],"topicSections":[{"anchor":"Topics","identifiers":["doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme","doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/Localization"]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackSheet","type":"reference","isActive":true},{"type":"text","text":" reads two kinds of customization from its "},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme","type":"reference","isActive":true},{"type":"text","text":" parameter:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Two accent colors"}]},{"type":"text","text":" — one for bug reports ("},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/bugAccent","type":"reference","isActive":true},{"type":"text","text":") and one for feature requests ("},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/featureAccent","type":"reference","isActive":true},{"type":"text","text":"). These drive the hero gradient, type-selector highlights, success ring, and submit-button accents."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"All visible strings"}]},{"type":"text","text":" — collected in "},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","type":"reference","isActive":true},{"type":"text","text":" so you can swap in pre-localized text without the SDK shipping a strings table."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One thing the theme deliberately does not cover: the native App Store rating prompt that can follow a submission. Its copy, layout, and localization come from the system, so there is nothing for "},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","type":"reference","isActive":true},{"text":" to override.","type":"text"}]},{"code":["FeedbackSheet(","    client: feedback,","    theme: FeedbackTheme(","        bugAccent: .red,","        featureAccent: .blue,","        copy: .default","    )",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Matching-your-brand","type":"heading","level":2,"text":"Matching your brand"},{"type":"paragraph","inlineContent":[{"text":"Most apps want the bug accent to look like a “destructive” color and the feature accent to look like a “primary” color. Both should have sufficient contrast against ","type":"text"},{"type":"codeVoice","code":"Color.white"},{"type":"text","text":" (the icon color on filled chips and the hero rectangle):"}]},{"code":["FeedbackTheme(","    bugAccent: Color(red: 0.95, green: 0.30, blue: 0.40),","    featureAccent: Color(red: 0.45, green: 0.45, blue: 1.00),","    copy: .default",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Color"},{"text":"-based instantiation works on all supported platforms; if you prefer asset-catalog colors:","type":"text"}]},{"code":["FeedbackTheme(","    bugAccent: Color(\"BugAccent\"),","    featureAccent: Color(\"FeatureAccent\"),","    copy: .default",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Defaults","type":"heading","level":2,"text":"Defaults"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/default","isActive":true,"type":"reference"},{"text":" provides a balanced red\/blue palette and English copy. Use it as the starting point for partial overrides:","type":"text"}]},{"code":["var theme = FeedbackTheme.default","theme.bugAccent = .orange   \/\/ matches AcmeApp's brand","let sheet = FeedbackSheet(client: feedback, theme: theme)"],"type":"codeListing","syntax":"swift"},{"anchor":"Customizing-the-description-limit","type":"heading","level":2,"text":"Customizing the description limit"},{"type":"paragraph","inlineContent":[{"text":"The character limit shown next to the description label is separate from the theme — it’s a constructor parameter on ","type":"text"},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackSheet","isActive":true,"type":"reference"},{"text":" because it affects validation, not visuals:","type":"text"}]},{"code":["FeedbackSheet(client: feedback, theme: .default, descriptionLimit: 2000)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The sheet shows the count in monospace and turns red over the limit, but does not currently block submission. Enforce hard limits in your transport if needed.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/loveletterui\/theming"]}],"references":{"doc://LoveLetterUI/documentation/LoveLetterUI":{"role":"collection","url":"\/do