xt"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"client","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The configured "},{"code":"FeedbackClient","type":"codeVoice"},{"type":"text","text":" used to submit the"},{"type":"text","text":" "},{"type":"text","text":"report. Build it once at app start and share across sheets."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Visual + copy customization. Defaults to "},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/default","type":"reference","isActive":true},{"type":"text","text":"."}]}],"name":"theme"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Character limit shown next to the description"},{"type":"text","text":" "},{"type":"text","text":"label. The counter turns red over the limit but does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" "},{"type":"text","text":"block submission — enforce hard limits in your transport if"},{"type":"text","text":" "},{"type":"text","text":"needed. Defaults to "},{"type":"codeVoice","code":"1000"},{"type":"text","text":"."}]}],"name":"descriptionLimit"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"text":" (the default), a successful","type":"text"},{"text":" ","type":"text"},{"text":"submission whose text is unqualified praise is followed by the","type":"text"},{"text":" ","type":"text"},{"text":"native App Store rating prompt, so happy users can turn that praise","type":"text"},{"text":" ","type":"text"},{"text":"into a rating without leaving the app.","type":"text"}]},{"inlineContent":[{"text":"The praise check runs entirely on-device via Apple Intelligence","type":"text"},{"type":"text","text":" "},{"text":"(Foundation Models, iOS\/macOS\/visionOS 26+). On any device without","type":"text"},{"text":" ","type":"text"},{"text":"it — older OS, ineligible hardware, Apple Intelligence switched off,","type":"text"},{"text":" ","type":"text"},{"text":"model still downloading — the check is skipped and the flow is","type":"text"},{"text":" ","type":"text"},{"text":"exactly as it was before this option existed. The report is always","type":"text"},{"type":"text","text":" "},{"text":"submitted first and is never affected by the outcome; text that","type":"text"},{"type":"text","text":" "},{"type":"text","text":"mixes praise with a bug, complaint, question, or request does not"},{"type":"text","text":" "},{"type":"text","text":"qualify. Inert on watchOS and tvOS, which have no rating prompt."}],"type":"paragraph"},{"inlineContent":[{"text":"The alert’s copy and its presentation frequency belong to the","type":"text"},{"text":" ","type":"text"},{"text":"system — it is deliberately not part of ","type":"text"},{"identifier":"doc:\/\/LoveLetterUI\/documentation\/LoveLetterUI\/FeedbackTheme\/Copy-swift.struct","type":"reference","isActive":true},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"the App Store shows it at most a few times per user per year.","type":"text"}],"type":"paragraph"}],"name":"requestsAppStoreReview"},{"name":"onSubmit","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Called on the main actor after a successful submission,"},{"type":"text","text":" "},{"type":"text","text":"with the backend-assigned identifier (GitHub issue number for"},{"type":"text","text":" "},{"type":"codeVoice","code":"GitHubDirectTransport"},{"type":"text","text":")."}]}]},{"name":"onError","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Called on the main actor when the transport throws. The"},{"type":"text","text":" "},{"type":"text","text":"sheet also displays an alert with "},{"type":"codeVoice","code":"error.localizedDescription"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so this callback is mainly for analyt