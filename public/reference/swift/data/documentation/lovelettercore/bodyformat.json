{"hierarchy":{"paths":[["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyFormatter","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyParser","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/ParsedFeedbackBody"],"anchor":"Topics"}],"seeAlsoSections":[{"title":"The wire contract","generated":true,"identifiers":["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyFormatter","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyParser","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/ParsedFeedbackBody"],"anchor":"The-wire-contract"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackClient\/submit(_:)","isActive":true},{"text":" runs, it asks the active ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackTransport","isActive":true},{"text":" to deliver a ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackReport","isActive":true},{"text":". For ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/GitHubDirectTransport","isActive":true},{"text":", that means a ","type":"text"},{"type":"codeVoice","code":"POST \/repos\/{owner}\/{repo}\/issues"},{"text":" with a JSON payload whose ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" is rendered by ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyFormatter","isActive":true},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The body is a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"wire contract"}]},{"type":"text","text":" — it is the only way structured fields travel between the submitting app and the Love Letter inbox. Any drift between the two halves silently loses columns in the inbox."}]},{"type":"heading","anchor":"The-exact-shape","level":2,"text":"The exact shape"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a report with description, contact email, and an "},{"type":"codeVoice","code":"extraFields"},{"text":" entry of ","type":"text"},{"code":"\"Branch\": \"release\/1.4\"","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"text","code":["<description>","","---","**Device Information:**","App: AcmeApp","App Version: 1.2.3 (456)","Device: MacBookPro18,1","macOS Version: Version 14.5 (Build 23F79)","","**Branch:**","release\/1.4","","**Contact Email:**","user@example.com","","---","👍 Votes: 0"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"contactEmail"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" or empty, the entire "},{"type":"codeVoice","code":"**Contact Email:**"},{"type":"text","text":" block is omitted. "},{"type":"codeVoice","code":"extraFields"},{"type":"text","text":" are emitted in alphabetical key order, each rendered as "},{"type":"codeVoice","code":"**Key:**\\nValue"},{"type":"text","text":". The trailing "},{"type":"codeVoice","code":"👍 Votes: 0"},{"type":"text","text":" line is preserved for compatibility with vote-counting tooling."}],"type":"paragraph"},{"level":2,"text":"OS labels per platform","anchor":"OS-labels-per-platform","type":"heading"},{"inlineContent":[{"text":"The line above the email block uses the platform-specific label ","type":"text"},{"code":"osName Version:","type":"codeVoice"},{"text":". The parser regex ","type":"text"},{"code":"^(OS|macOS|iOS|iPadOS|watchOS|tvOS|visionOS|Android|Windows|Linux|Web|ChromeOS) Version:","type":"codeVoice"},{"text":" recognises all of these:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"macOS Version: …"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"iOS Version: …"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"iPadOS Version: …"}]}]},{"content":[{"inlineContent":[{"code":"watchOS Version: …","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"tvOS Version: …"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"visionOS Version: …","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Android Version: …","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Windows Version: …","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Linux Version: …","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Web Version: …"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ChromeOS Version: …"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"So whichever value you put in "},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/DeviceInfo\/osName","isActive":true},{"type":"text","text":", the inbox parses it correctly."}],"type":"paragraph"},{"type":"heading","text":"Labels","anchor":"Labels","level":2},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyFormatter\/labels(for:)","type":"reference"},{"text":" returns the two label strings that get applied to the GitHub issue:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["IssueBodyFormatter.labels(for: .bug)","\/\/ [\"bug\", \"user-submitted\"]","","IssueBodyFormatter.labels(for: .featureRequest)","\/\/ [\"feature-request\", \"user-submitted\"]"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"These are also part of the contract: the inbox filters and groups by them."}],"type":"paragraph"},{"type":"heading","text":"Parsing it back","anchor":"Parsing-it-back","level":2},{"inlineContent":[{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyParser\/parse(_:)","type":"reference","isActive":true},{"text":" is the inverse:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let body = IssueBodyFormatter.format(report: report, deviceInfo: info)","let parsed = IssueBodyParser.parse(body)","","parsed.appName       \/\/ \"AcmeApp\"","parsed.appVersion    \/\/ \"1.2.3 (456)\"","parsed.device        \/\/ \"MacBookPro18,1\"","parsed.osVersion     \/\/ \"Version 14.5 (Build 23F79)\"","parsed.email         \/\/ \"user@example.com\"","parsed.description   \/\/ \"<description>\""],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The roundtrip is verified by the SDK’s test suite, so any change to the format gets caught at build time."}],"type":"paragraph"},{"type":"heading","text":"Resilience","anchor":"Resilience","level":2},{"inlineContent":[{"text":"The parser accepts a few variations seen in hand-written bodies:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Bold markers in any position (","type":"text"},{"code":"**Contact Email:** foo@bar.com","type":"codeVoice"},{"text":" on one line, or ","type":"text"},{"type":"codeVoice","code":"**Contact Email:**\\nfoo@bar.com"},{"text":" on two).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"OS Version:"},{"text":" as a generic label (treated like ","type":"text"},{"code":"macOS Version:","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Horizontal rule (---)"},{"type":"text","text":" separators are stripped from the description."}]}]},{"content":[{"inlineContent":[{"text":"Lines outside the ","type":"text"},{"type":"codeVoice","code":"**Device Information:**"},{"text":" block are treated as description content.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"It does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" parse arbitrary YAML, JSON, or HTML — keep submissions plain text and the contract holds.","type":"text"}]}],"kind":"content"}],"sections":[],"metadata":{"title":"The Body Format","modules":[{"name":"LoveLetterCore"}],"roleHeading":"API Collection","role":"collectionGroup"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lovelettercore\/bodyformat"]}],"abstract":[{"type":"text","text":"A fixed, structured shape for the GitHub issue body that the Love Letter inbox can parse back into typed fields."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/BodyFormat"},"kind":"article","references":{"doc://LoveLetterCore/documentation/LoveLetterCore/ParsedFeedbackBody":{"title":"ParsedFeedbackBody","navigatorTitle":[{"kind":"identifier","text":"ParsedFeedbackBody"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ParsedFeedbackBody"}],"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/ParsedFeedbackBody","url":"\/documentation\/lovelettercore\/parsedfeedbackbody","abstract":[{"text":"The structured fields extracted from an issue body by ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyParser","isActive":true},{"text":".","type":"text"}],"kind":"symbol","role":"symbol"},"doc://LoveLetterCore/documentation/LoveLetterCore/FeedbackTransport":{"type":"topic","navigatorTitle