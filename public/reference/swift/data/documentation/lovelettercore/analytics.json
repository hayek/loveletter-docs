{"sections":[],"abstract":[{"type":"text","text":"Observe the whole feedback funnel through one optional sink."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"FeedbackSheet","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"onSubmit","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"onError","type":"codeVoice"},{"type":"text","text":" callbacks report a completed"},{"type":"text","text":" "},{"type":"text","text":"submission. They cannot tell you how many people opened the sheet and left, how"},{"type":"text","text":" "},{"type":"text","text":"many were blocked by validation, or how many were asked to rate the app."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackAnalytics","type":"reference"},{"text":" is a single optional sink that receives all of it. Conform,","type":"text"},{"text":" ","type":"text"},{"text":"pass it to the client, and forward:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct MyAnalytics: FeedbackAnalytics {","    func record(_ event: FeedbackEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters)","    }","}","","let feedback = FeedbackClient(","    appName: \"AcmeApp\",","    transport: GitHubDirectTransport(owner: \"acme\", repo: \"feedback\", token: token),","    analytics: MyAnalytics()",")"]},{"inlineContent":[{"text":"That is the whole integration. ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/name","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/parameters","isActive":true,"type":"reference"},{"text":" are already shaped for Firebase, Mixpanel,","type":"text"},{"text":" ","type":"text"},{"text":"Amplitude, PostHog, and TelemetryDeck — ","type":"text"},{"code":"[String: String]","type":"codeVoice"},{"text":" converts implicitly to","type":"text"},{"text":" ","type":"text"},{"code":"[String: Any]","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pass nothing and the SDK behaves exactly as it did before this API existed."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Configure it once, on the client","anchor":"Configure-it-once-on-the-client"},{"inlineContent":[{"text":"There is deliberately ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"analytics:","type":"codeVoice"},{"text":" parameter on ","type":"text"},{"code":"FeedbackSheet","type":"codeVoice"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"sheet reads the sink from the client it was given, so one object receives the","type":"text"},{"text":" ","type":"text"},{"text":"submission lifecycle ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" the UI funnel.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A sheet-level parameter would let you configure a sink that silently never"},{"type":"text","text":" "},{"type":"text","text":"receives "},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/submissionStarted(_:attachmentCount:hasContactEmail:)","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"or "},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/submissionSucceeded(_:issueNumber:)","type":"reference","isActive":true},{"type":"text","text":" — the exact questions"},{"type":"text","text":" "},{"type":"text","text":"you added analytics to answer — with no compiler help."}]},{"type":"paragraph","inlineContent":[{"text":"Each event has exactly one emitter, so nothing is ever double-counted: the client","type":"text"},{"text":" ","type":"text"},{"text":"owns the submission lifecycle, the sheet owns everything else.","type":"text"}]},{"type":"heading","text":"The vocabulary","level":2,"anchor":"The-vocabulary"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Event","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"name"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Parameters"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/sheetPresented","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"feedback_sheet_presented","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/typeSelected(_:)","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"code":"feedback_type_selected","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"type"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/attachmentAdded(source:)","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"feedback_attachment_added"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"source"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/attachmentRejected(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"feedback_attachment_rejected"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"reason"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/LoveLetterCo