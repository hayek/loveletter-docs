nlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/ratingPromptRequested"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"feedback_rating_prompt_requested"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"—"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/ratingPromptSuppressed(reason:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"feedback_rating_prompt_suppressed"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"reason"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A few of these are easy to misread:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/cancelled","isActive":true}],"type":"strong"},{"type":"text","text":" means "},{"inlineContent":[{"type":"text","text":"left without a successful submission"}],"type":"emphasis"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The sheet has no Cancel button — this covers swipe, Escape, and the host app"},{"type":"text","text":" "},{"type":"text","text":"dismissing it. An app terminated with the sheet open emits nothing."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/typeSelected(_:)","type":"reference","isActive":true}],"type":"strong"},{"text":" fires only when the type actually","type":"text"},{"text":" ","type":"text"},{"text":"changes. The initial ","type":"text"},{"code":".bug","type":"codeVoice"},{"text":" default is not a selection, so read the submitted","type":"text"},{"text":" ","type":"text"},{"text":"type from the submission events rather than inferring it here.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/ratingPromptRequested","isActive":true}],"type":"strong"},{"text":" means the SDK asked the system.","type":"text"},{"text":" ","type":"text"},{"text":"Whether a prompt appeared is not observable — see below.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/attachmentAdded(source:)","isActive":true,"type":"reference"}],"type":"strong"},{"text":" fires per file, ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" ","type":"text"},{"text":"validation. An oversized file emits this and then","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/attachmentRejected(_:)","isActive":true},{"type":"text","text":", so it is not a count of accepted"},{"type":"text","text":" "},{"type":"text","text":"files. The rejection fires per "},{"type":"emphasis","inlineContent":[{"text":"reason","type":"text"}]},{"type":"text","text":", not per file."}]}]}]},{"inlineContent":[{"text":"Equality on ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent","isActive":true,"type":"reference"},{"text":" is over ","type":"text"},{"code":"name","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"parameters","type":"codeVoice"},{"text":", so it is coarser than","type":"text"},{"text":" ","type":"text"},{"text":"the associated values: two failures of the same kind are equal even with","type":"text"},{"text":" ","type":"text"},{"text":"different underlying errors. Match the case if your test needs the carried","type":"text"},{"text":" ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" itself.","type":"text"}],"type":"paragraph"},{"text":"What you cannot know","level":2,"anchor":"What-you-cannot-know","type":"heading"},{"inlineContent":[{"text":"There is no ","type":"text"},{"code":"userRated","type":"codeVoice"},{"text":" event, and no ","type":"text"},{"code":"ratingPromptShown","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RequestReviewAction"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"Void"},{"type":"text","text":". It has no completion handler and no result."},{"type":"text","text":" "},{"type":"text","text":"The system decides on its own whether to show anything — it rate-limits to a few"},{"type":"text","text":" "},{"type":"text","text":"prompts per user per year and stays silent otherwise — and Apple exposes no API"},{"type":"text","text":" "},{"type":"text","text":"for whether the alert appeared or whether the person rated. Shipping either event"},{"type":"text","text":" "},{"type":"text","text":"would mean shipping something that can never fire correctly."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/ratingPromptSuppressed(reason:)"},{"type":"text","text":" is the useful half: it tells you"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"why"}],"type":"emphasis"},{"type":"text","text":" a happy user was not asked, which is otherwise invisible because the praise"},{"type":"text","text":" "},{"type":"text","text":"check is on-device and silent. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/RatingPromptSuppressionReason"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On watchOS and tvOS no rating events are emitted at all — neither the rating"},{"type":"text","text":" "},{"type":"text","text":"prompt nor Apple Intelligence exists there, so the code is compiled out."}]},{"level":2,"type":"heading","text":"Privacy","anchor":"Privacy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No event ever carries user-authored content. Not titles, not descriptions, not"},{"type":"text","text":" "},{"type":"text","text":"email addresses, not attachment filenames, not attachment bytes."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/submissionFailed(_:error:)","type":"reference","isActive":true},{"type":"text","text":" carries the "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" for your own"},{"type":"text","text":" "},{"type":"text","text":"logging but projects only a short, stable "},{"type":"codeVoice","code":"error_kind"},{"type":"text","text":" token into"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/parameters","type":"reference"},{"text":" — ","type":"text"},{"code":"network","type":"codeVoice"},{"text":", ","type":"text"},{"code":"http_422","type":"codeVoice"},{"text":", ","type":"text"},{"code":"attachment_upload","type":"codeVoice"},{"text":", and so","type":"text"},{"text":" ","type":"text"},{"text":"on. This is not cosmetic: ","type":"text"},{"code":"FeedbackSubmissionError.attachmentUpload","type":"codeVoice"},{"text":" interpolates","type":"text"},{"text":" ","type":"text"},{"text":"the user’s filename into its ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".transport","type":"codeVoice"},{"text":" forwards a","type":"text"},{"text":" ","type":"text"},{"code":"URLError","type":"codeVoice"},{"text":" description that can name your relay host. Neither belongs in a","type":"text"},{"text":" ","type":"text"},{"text":"third-party analytics vendor.","type":"text"}]},{"inlineContent":[{"code":"attachment_count","type":"codeVoice"},{"type":"text","text":" and "},{"code":"has_email","type":"codeVoice"},{"type":"text","text":" answer “do people attach things, do they leave"},{"type":"text","text":" "},{"type":"text","text":"an address” without carrying either."}],"type":"paragraph"},{"level":2,"text":"Isolation","anchor":"Isolation","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackAnalytics\/record(_:)","isActive":true},{"type":"text","text":" is synchronous and "},{"type":"codeVoice","code":"nonisolated"},{"text":". It is called on","type":"text"},{"text":" ","type":"text"},{"text":"whichever context the event happened on: the main actor for sheet events, and","type":"text"},{"text":" ","type":"text"},{"text":"whatever context called ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackClient\/submit(_:)","isActive":true,"type":"reference"},{"text":" for submission events. Keep","type":"text"},{"text":" ","type":"text"},{"text":"it cheap and non-blocking, and do not assume the main actor.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That choice is deliberate. An "},{"type":"codeVoice","code":"async"},{"type":"text","text":" requirement would push every emission site"},{"type":"text","text":" "},{"type":"text","text":"into a detached task, and "},{"type":"codeVoice","code":"submissionStarted"},{"type":"text","text":" could then be delivered "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"submissionSucceeded"},{"type":"text","text":" for the same submission — event order is worth more here"},{"type":"text","text":" "},{"type":"text","text":"than the convenience."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most vendor SDKs are callable from any thread, so the conformance above works"},{"type":"text","text":" "},{"type":"text","text":"as-is. If your analytics wrapper is "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":"-isolated, note that a"},{"type":"text","text":" "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" method cannot satisfy a "},{"code":"nonisolated","type":"codeVoice"},{"type":"text","text":" requirement, and an isolated"},{"type":"text","text":" "},{"type":"text","text":"conformance is rejected because "},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackAnalytics","isActive":true},{"type":"text","text":" refines "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". Hop"},{"type":"text","text":" "},{"type":"text","text":"explicitly — accepting that the hop gives up the ordering the synchronous"},{"type":"text","text":" "},{"type":"text","text":"requirement was protecting, so buffer in "},{"type":"codeVoice","code":"record"},{"type":"text","text":" if order matters to you:"}]},{"code":["struct MyAnalytics: FeedbackAnalytics {","    nonisolated func record(_ event: FeedbackEvent) {","        Task { @MainActor in","            MyTracker.shared.track(event.name, event.parameters)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackAnalytics\/record(_:)","isActive":true},{"text":" is called synchronously and inline. Most events","type":"text"},{"text":" ","type":"text"},{"text":"are reported after the fact and can only waste time, but","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/submissionStarted(_:attachmentCount:hasContactEmail:)","isActive":true},{"text":" is emitted","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the transport is awaited — on the main actor when the sheet is driving —","type":"text"},{"text":" ","type":"text"},{"text":"so a slow implementation there delays the request and blocks the UI.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"record","type":"codeVoice"},{"text":" is non-throwing, so a trap crashes your app with nothing for the SDK to","type":"text"},{"text":" ","type":"text"},{"text":"swallow; a trap in ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/submissionSucceeded(_:issueNumber:)","isActive":true,"type":"reference"},{"text":" crashes","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"type":"text","text":" the issue was filed, so the user sees no confirmation and files it again."},{"type":"text","text":" "},{"type":"text","text":"Keep "},{"type":"codeVoice","code":"record"},{"type":"text","text":" to a synchronous hand-off and do the real work asynchronously."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"What the SDK does guarantee: nothing you do here changes what is submitted or","type":"text"},{"text":" ","type":"text"},{"text":"whether it succeeds, and the App Store rating flow never calls ","type":"text"},{"code":"record","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"text":"inside itself.","type":"text"}]},{"type":"heading","level":2,"text":"New cases arrive in minor releases","anchor":"New-cases-arrive-in-minor-releases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The vocabulary will grow. This package is distributed as source rather than as a"},{"type":"text","text":" "},{"type":"text","text":"library-evolution-enabled binary framework, so a "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" over "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"without","type":"text"}]},{"type":"text","text":" a "},{"code":"default:","type":"codeVoice"},{"type":"text","text":" becomes a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"compile error"}]},{"type":"text","text":" on the next minor release —"},{"type":"text","text":" "},{"type":"text","text":"not a warning, and "},{"code":"@unknown default","type":"codeVoice"},{"type":"text","text":" is not the right tool here."}]},{"type":"paragraph","inlineContent":[{"text":"Either forward ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/name","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/parameters","isActive":true,"type":"reference"},{"text":", which is","type":"text"},{"text":" ","type":"text"},{"text":"what most integrations want and never breaks:","type":"text"}]},{"type":"codeListing","code":["func record(_ event: FeedbackEvent) {","    Analytics.logEvent(event.name, parameters: event.parameters)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"…or match exhaustively "},{"type":"emphasis","inlineContent":[{"type":"text","text":"with"}]},{"type":"text","text":" a "},{"type":"codeVoice","code":"default:"},{"type":"text","text":":"}]},{"type":"codeListing","code":["func record(_ event: FeedbackEvent) {","    switch event {","    case .submissionSucceeded(let type, let issueNumber):","        celebrate(type, issueNumber)","    case .cancelled:","        noteDropOff()","    default:","        break","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"name","type":"codeVoice"},{"type":"text","text":" strings are covered by tests that fail on a rename, so a dashboard"},{"type":"text","text":" "},{"type":"text","text":"built on them will not silently go empty."}]},{"anchor":"Relationship-to-the-sheets-callbacks","text":"Relationship to the sheet’s callbacks","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onSubmit"},{"type":"text","text":", "},{"type":"codeVoice","code":"onError"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onSubmitReport"},{"type":"text","text":" are "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" deprecated and fire"},{"type":"text","text":" "},{"type":"text","text":"alongside events. They serve a different purpose: they are control-flow hooks for"},{"type":"text","text":" "},{"type":"text","text":"your app — show a toast, refresh a list — and they run on the main actor with"},{"type":"text","text":" "},{"type":"text","text":"that in mind. Analytics is observation. Use whichever fits; using both is fine."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lovelettercore\/analytics"]}],"identifier":{"url":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/Analytics","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore"]]},"seeAlsoSections":[{"title":"Observability","identifiers":["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackAnalytics","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackField","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/AttachmentSource","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/RatingPromptSuppressionReason"],"anchor":"Observability","generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","metadata":{"title":"Analytics","roleHeading":"Article","role":"article","modules":[{"name":"LoveLetterCore"}]},"references":{"doc://LoveLette