,{"type":"text","text":" understands."}],"type":"topic","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyFormatter","navigatorTitle":[{"kind":"identifier","text":"IssueBodyFormatter"}],"title":"IssueBodyFormatter"},"doc://LoveLetterCore/documentation/LoveLetterCore/FeedbackClient":{"title":"FeedbackClient","navigatorTitle":[{"kind":"identifier","text":"FeedbackClient"}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeedbackClient"}],"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackClient","url":"\/documentation\/lovelettercore\/feedbackclient","abstract":[{"type":"text","text":"The entry point for submitting feedback."}],"kind":"symbol","role":"symbol"},"doc://LoveLetterCore/documentation/LoveLetterCore":{"url":"\/documentation\/lovelettercore","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore","role":"collection","abstract":[{"type":"text","text":"Submit feedback from any Apple platform to a GitHub repository in the exact body format the Love Letter inbox parses."}],"title":"LoveLetterCore","type":"topic","kind":"symbol"},"doc://LoveLetterCore/documentation/LoveLetterCore/FeedbackClient/init(transport:deviceInfo:analytics:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"transport"},{"kind":"text","text":": "},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"preciseIdentifier":"s:14LoveLetterCore17FeedbackTransportP","kind":"typeIdentifier","text":"FeedbackTransport"},{"kind":"text","text":", "},{"kind":"externalParam","text":"deviceInfo"},{"kind":"text","text":": "},{"preciseIdentifier":"s:14LoveLetterCore10DeviceInfoV","kind":"typeIdentifier","text":"DeviceInfo"},{"kind":"text","text":", "},{"kind":"externalParam","text":"analytics"},{"kind":"text","text":": ("},{"kind":"keyword","text":"any"},{"kind":"text","text":" "},{"preciseIdentifier":"s:1