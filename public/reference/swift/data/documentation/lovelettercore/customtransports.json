{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/CustomTransports"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"article","metadata":{"role":"collectionGroup","modules":[{"name":"LoveLetterCore"}],"roleHeading":"API Collection","title":"Custom Transports"},"seeAlsoSections":[{"title":"Transports","identifiers":["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/SecretsAndTokens","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackTransport","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/GitHubDirectTransport","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/RelayTransport"],"anchor":"Transports","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackClient","isActive":true},{"type":"text","text":" knows nothing about GitHub. All it does is collect "},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/DeviceInfo","isActive":true},{"type":"text","text":" and hand the "},{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackReport","type":"reference"},{"text":" to its ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackTransport"},{"text":". Anything that can produce an ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" from that pair is a valid transport.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public protocol FeedbackTransport: Sendable {","    func submit(_ report: FeedbackReport, deviceInfo: DeviceInfo) async throws -> Int","}"]},{"anchor":"Use-the-built-in-relay-transport","type":"heading","level":2,"text":"Use the built-in relay transport"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The most common reason to replace the default transport is to avoid shipping a GitHub PAT inside the app binary (see "},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/SecretsAndTokens","isActive":true},{"type":"text","text":"). A relay server holds the credential, exposes a thin HTTPS endpoint, and applies abuse controls. "},{"inlineContent":[{"text":"You don’t have to write this transport","type":"text"}],"type":"strong"},{"text":" — the SDK ships ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/RelayTransport"},{"text":", which speaks the canonical relay contract (the same one the Love Letter Web and Android SDKs target):","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let transport = RelayTransport(","    endpoint: URL(string: \"https:\/\/your-relay.example.com\/api\/feedback\")!,","    captchaTokenProvider: { await captcha.freshToken() }  \/\/ optional, fetched per submit",")","let feedback = FeedbackClient(appName: \"AcmeApp\", transport: transport)"]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/RelayTransport"},{"text":" POSTs a JSON body with ","type":"text"},{"type":"codeVoice","code":"type"},{"text":", ","type":"text"},{"type":"codeVoice","code":"title"},{"text":", ","type":"text"},{"type":"codeVoice","code":"description"},{"text":", optional ","type":"text"},{"type":"codeVoice","code":"contactEmail"},{"text":", ","type":"text"},{"type":"codeVoice","code":"extraFields"},{"text":", a nested ","type":"text"},{"code":"deviceInfo","type":"codeVoice"},{"text":" object, and optional ","type":"text"},{"code":"captchaToken","type":"codeVoice"},{"text":", then decodes the relay’s ","type":"text"},{"code":"{ \"issueNumber\", \"issueUrl\" }","type":"codeVoice"},{"text":" response. No GitHub credential ever ships in the app binary.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The optional "},{"type":"codeVoice","code":"captchaTokenProvider"},{"type":"text","text":" is an "},{"type":"codeVoice","code":"async"},{"type":"text","text":" closure invoked "},{"type":"strong","inlineContent":[{"type":"text","text":"once per submission"}]},{"type":"text","text":", so each request carries a fresh Turnstile\/hCaptcha token — these are single-use and expire in minutes, and the transport outlives any one submission. Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" (or omit the provider) to leave "},{"type":"codeVoice","code":"captchaToken"},{"type":"text","text":" out of the body."}],"type":"paragraph"},{"anchor":"Writing-your-own-relay-transport","text":"Writing your own relay transport","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"If your backend speaks a different protocol, conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackTransport"},{"type":"text","text":" directly. The example below mirrors the same wire shape "},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/RelayTransport"},{"type":"text","text":" uses — a nested "},{"type":"codeVoice","code":"deviceInfo"},{"type":"text","text":" object, "},{"type":"codeVoice","code":"contactEmail"},{"text":" (not ","type":"text"},{"type":"codeVoice","code":"email"},{"text":"), and ","type":"text"},{"code":"extraFields","type":"codeVoice"},{"text":" plus an optional ","type":"text"},{"type":"codeVoice","code":"captchaToken"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public struct MyRelayTransport: FeedbackTransport {","    public let endpoint: URL","    public let captchaToken: String?","    public let session: URLSession","","    public init(endpoint: URL, captchaToken: String? = nil, session: URLSession = .shared) {","        self.endpoint = endpoint","        self.captchaToken = captchaToken","        self.session = session","    }","","    public func submit(_ report: FeedbackReport, deviceInfo: DeviceInfo) async throws -> Int {","        struct DeviceInfoPayload: Encodable {","            let appName: String","            let appVersion: String","            let buildNumber: String","            let model: String","            let osName: String","            let osVersion: String","        }","        struct Payload: Encodable {","            let type: FeedbackType","            let title: String","            let description: String","            let contactEmail: String?","            let extraFields: [String: String]","            let deviceInfo: DeviceInfoPayload","            let captchaToken: String?","        }","        let payload = Payload(","            type: report.type,","            title: report.title,","            description: report.description,","            contactEmail: report.contactEmail,","            extraFields: report.extraFields,","            deviceInfo: DeviceInfoPayload(","                appName: deviceInfo.appName,","                appVersion: deviceInfo.appVersion,","                buildNumber: deviceInfo.buildNumber,","                model: deviceInfo.model,","                osName: deviceInfo.osName,","                osVersion: deviceInfo.osVersion","            ),","            captchaToken: captchaToken","        )","","        var request = URLRequest(url: endpoint)","        request.httpMethod = \"POST\"","        request.setValue(\"application\/json\", forHTTPHeaderField: \"Content-Type\")","        request.httpBody = try JSONEncoder().encode(payload)","","        let (data, response) = try await session.data(for: request)","        guard let http = response as? HTTPURLResponse, (200..<300).contains(http.statusCode) else {","            throw FeedbackSubmissionError.invalidResponse","        }","","        struct Response: Decodable { let issueNumber: Int }","        return try JSONDecoder().decode(Response.self, from: data).issueNumber","    }","}"]},{"inlineContent":[{"type":"text","text":"Your relay can then call GitHub itself using "},{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyFormatter","type":"reference"},{"type":"text","text":" for the body, or store the report in a database, or fan it out to multiple destinations — the client is unchanged."}],"type":"paragraph"},{"type":"heading","text":"A test transport","anchor":"A-test-transport","level":2},{"inlineContent":[{"text":"For unit tests, build a transport that records calls and returns a canned result:","type":"text"}],"type":"paragraph"},{"code":["final class RecordingTransport: FeedbackTransport, @unchecked Sendable {","    private(set) var submitted: [(FeedbackReport, DeviceInfo)] = []","    var nextResult: Result<Int, any Error> = .success(0)","","    func submit(_ report: FeedbackReport, deviceInfo: DeviceInfo) async throws -> Int {","        submitted.append((report, deviceInfo))","        return try nextResult.get()","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Pass it to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackClient\/init(transport:deviceInfo:analytics:)","type":"reference"},{"text":" with a fixed ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/DeviceInfo","type":"reference"},{"text":" for fully deterministic tests.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Error contract","anchor":"Error-contract","level":2},{"type":"paragraph","inlineContent":[{"text":"Transports should throw ","type":"text"},{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackSubmissionError","type":"reference"},{"text":" for known conditions and let other errors propagate. The SDK’s UI layer ","type":"text"},{"code":"LoveLetterUI\/FeedbackSheet","type":"codeVoice"},{"text":" displays ","type":"text"},{"code":"error.localizedDescription","type":"codeVoice"},{"text":" in an alert, so make sure your errors conform to ","type":"text"},{"code":"LocalizedError","type":"codeVoice"},{"text":" if you want friendly messages.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore"],["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/SecretsAndTokens"]]},"topicSections":[{"identifiers":["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackTransport","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/GitHubDirectTransport","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/RelayTransport","doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackSubmissionError"],"anchor":"Topics"}],"variants":[{"paths":["\/documentation\/lovelettercore\/customtransports"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Replace ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/GitHubDirectTransport","type":"reference","isActive":true},{"type":"text","text":" with a relay server, a mock, or any other backend by conforming to "},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackTransport","isActive":true},{"type":"text","text":"."}],"references":{"doc://LoveLetterCore/documentation/LoveLetterCore/FeedbackTransport":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"FeedbackTransport"}],"abstract":[{"type":"text","text":"Where a "},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackReport","isActive":true},{"text":" gets delivered.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"FeedbackTransport"}],"title":"FeedbackTransport","url":"\/documentation\/lovelettercore\/feedbacktransport","role":"symbol","kind":"symbol","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackTransport"},"doc://LoveLetterCore/documentation/LoveLetterCore/FeedbackSubmissionError":{"title":"FeedbackSubmissionError","kind":"symbol","type":"topic","navigatorTitle":[{"text":"FeedbackSubmissionError","kind":"identifier"}],"url":"\/documentation\/lovelettercore\/feedbacksubmissionerror","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeedbackSubmissionError","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Errors thrown by ","type":"text"},{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/GitHubDirectTransport","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackSubmissionError"},"doc://LoveLetterCore/documentation/LoveLetterCore/IssueBodyParser/parse(_:)":{"url":"\/documentation\/lovelettercore\/issuebodyparser\/parse(_:)","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"parse","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:14LoveLetterCore18ParsedFeedbackBodyV","text":"ParsedFeedbackBody","kind":"typeIdentifier"}],"abstract":[{"text":"Parses a raw GitHub issue body into structured fields.","type":"text"}],"type":"topic","role":"symbol","title":"parse(_:)","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/IssueBodyParser\/parse(_:)"},"doc://LoveLetterCore/documentation/LoveLetterCore/FeedbackReport":{"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackReport","title":"FeedbackReport","type":"topic","fragments":[{"text":"stru