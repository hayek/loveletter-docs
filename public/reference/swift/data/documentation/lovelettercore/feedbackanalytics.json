{"kind":"symbol","topicSections":[{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackAnalytics\/record(_:)"],"generated":true}],"metadata":{"externalID":"s:14LoveLetterCore17FeedbackAnalyticsP","navigatorTitle":[{"kind":"identifier","text":"FeedbackAnalytics"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeedbackAnalytics","kind":"identifier"}],"role":"symbol","modules":[{"name":"LoveLetterCore"}],"title":"FeedbackAnalytics","roleHeading":"Protocol","symbolKind":"protocol"},"hierarchy":{"paths":[["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore"]]},"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/LoveLetterCore\/s8SendableP","doc:\/\/LoveLetterCore\/s16SendableMetatypeP"],"type":"inheritsFrom"}],"abstract":[{"text":"Receives ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent"},{"text":" values as the user moves through the feedback flow.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FeedbackAnalytics","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/Analytics"]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Analytics are entirely optional. Pass a conformance to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackClient\/init(appName:transport:analytics:)"},{"type":"text","text":" and both the client and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FeedbackSheet"},{"type":"text","text":" report through it; pass nothing and the SDK"},{"type":"text","text":" "},{"type":"text","text":"behaves exactly as it did before this API existed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Most conformances are one line, because "},{"isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent","type":"reference"},{"text":" projects itself","type":"text"},{"text":" ","type":"text"},{"text":"into the shape every analytics vendor already takes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyAnalytics: FeedbackAnalytics {","    func record(_ event: FeedbackEvent) {","        Analytics.logEvent(event.name, parameters: event.parameters)","    }","}"]},{"type":"heading","level":2,"text":"Isolation","anchor":"Isolation"},{"type":"paragraph","inlineContent":[{"code":"record","type":"codeVoice"},{"type":"text","text":" is synchronous and "},{"code":"nonisolated","type":"codeVoice"},{"type":"text","text":". It is called on whichever context"},{"type":"text","text":" "},{"type":"text","text":"the event happened on — the main actor for sheet events, and whatever context"},{"type":"text","text":" "},{"type":"text","text":"called "},{"type":"reference","identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackClient\/submit(_:)","isActive":true},{"type":"text","text":" for submission events. Keep it cheap and"},{"type":"text","text":" "},{"type":"text","text":"non-blocking, and do not assume the main actor."}]},{"type":"paragraph","inlineContent":[{"text":"Isolation is deliberate rather than incidental: an ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" requirement would","type":"text"},{"text":" ","type":"text"},{"text":"force every emission site into a detached task, and","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/submissionStarted(_:attachmentCount:hasContactEmail:)"},{"text":" could","type":"text"},{"text":" ","type":"text"},{"text":"then be delivered ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"text":" the success event for the same submission.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your analytics wrapper is "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":"-isolated, a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" method"},{"type":"text","text":" "},{"type":"text","text":"cannot satisfy this requirement and an isolated conformance is rejected"},{"type":"text","text":" "},{"type":"text","text":"because the protocol refines "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". Hop explicitly instead:"}]},{"syntax":"swift","type":"codeListing","code":["nonisolated func record(_ event: FeedbackEvent) {","    Task { @MainActor in MyAnalytics.shared.track(event.name, event.parameters) }","}"]},{"level":2,"text":"Guarantees, and what is not guaranteed","anchor":"Guarantees-and-what-is-not-guaranteed","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"record"},{"type":"text","text":" is called synchronously and inline. Most events are reported after"},{"type":"text","text":" "},{"type":"text","text":"the fact and can only waste time, but"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/submissionStarted(_:attachmentCount:hasContactEmail:)"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"emitted "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the transport is awaited — on the main actor when the sheet"},{"type":"text","text":" "},{"type":"text","text":"is driving — so a slow implementation there delays the request and blocks the"},{"type":"text","text":" "},{"type":"text","text":"UI. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/LoveLetterCore\/documentation\/LoveLetterCore\/FeedbackEvent\/submissionSucceeded(_:issueNumber:)"},{"type":"text","text":" lands between the"},{"type":"text","text":" "},{"type":"text","text":"transport returning and your caller receiving the identifier."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"record"},{"text":" is also non-throwing, so if your implementation traps the SDK has","type":"text"},{"text":" ","type":"text"},{"text":"nothing to swallow and your app crashes — and a trap in the success event","type":"text"},{"text":" ","type":"text"},{"text":"crashes ","type":"text"},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"text":" the issue was already filed, so the user sees no confirmation","type":"text"},{"text":" ","type":"text"},{"text":"and files it again. Keep it to a synchronous hand-off; do any real work","type":"text"},{"text":" ","type":"text"},{"text":"asynchronously.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"What the SDK does guarantee: nothing you do here changes what is submitted or"},{"type":"text","text":" "},{"type":"text","text":"whether it succeeds, and the App Store rating flow never calls "},{"type":"codeVoice","code":"record"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"text","text":"inside itself."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No event ever carries user content: titles, descriptions, email addresses,"},{"type":"text","text":" "},{"type":"text","text":"attachment filenames, and attachment bytes stay out of the analytics stream."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/lovelettercore\/feedbackana